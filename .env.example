# ==============================================================================
# WEB DEVELOPMENT SOCIETY — MSIT (WDS MSIT)
# Environment Configuration Template (WDS OS v2.1 Backend)
# ==============================================================================

# Node Environment
NODE_ENV=development

# Notion API Integration Secrets
NOTION_API_KEY=secret_notion_api_key_here

# Notion Core Operational Databases
NOTION_RECRUITMENT_DATABASE_ID=recruitment_database_id_here
NOTION_DATABASE_ID=recruitment_database_id_here # Fallback alias
NOTION_INTERVIEWS_DATABASE_ID=interviews_database_id_here
NOTION_TASKS_DATABASE_ID=tasks_database_id_here
NOTION_BUGS_DATABASE_ID=bugs_database_id_here
NOTION_PROJECTS_DATABASE_ID=projects_database_id_here
NOTION_EVENTS_DATABASE_ID=events_database_id_here
NOTION_CONTENT_DATABASE_ID=content_database_id_here
NOTION_MEMBERS_DATABASE_ID=members_database_id_here
NOTION_ASSETS_DATABASE_ID=assets_database_id_here
NOTION_FACULTY_DATABASE_ID=faculty_database_id_here
NOTION_MEETINGS_DATABASE_ID=meetings_database_id_here
NOTION_INCIDENTS_DATABASE_ID=incidents_database_id_here
NOTION_DOCUMENTATION_DATABASE_ID=documentation_database_id_here
NOTION_AUDIT_DATABASE_ID=audit_database_id_here

# WDS Hub Role-Based Access Keys (Server-Side Credential Verification)
HUB_ADMIN_KEY=your_admin_secret_key_here
HUB_CORE_KEY=your_core_lead_secret_key_here
HUB_LEAD_KEY=your_tech_lead_secret_key_here
HUB_MEMBER_KEY=your_member_secret_key_here

# Hub Session Secret (HMAC-SHA256 Session Token Signing)
HUB_SESSION_SECRET=your_32_character_cryptographic_secret_here

# Bug Hunt Integration Webhook Secret (HMAC SHA-256 Signature Verification)
BUG_HUNT_WEBHOOK_SECRET=your_hmac_webhook_secret_here

# Deployment & Domain Canonical
NEXT_PUBLIC_APP_URL=https://wds-msit.vercel.app
