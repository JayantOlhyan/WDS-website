# ==============================================================================
# WDS MSIT - Environment Variables Configuration
# ==============================================================================

# Notion Integration for Recruitment Applications
# 1. Create an integration at https://www.notion.so/my-integrations
# 2. Add your integration token below
NOTION_API_KEY=your_secret_notion_integration_token

# 3. Share your existing WDS Recruitment Database with your Notion Integration
# 4. Copy the Database ID from the Notion URL and paste below
NOTION_DATABASE_ID=your_notion_database_id

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
